<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f2faf6;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tonguely.Controller.PrincipalUsuarioController">
   <top>
      <VBox spacing="18.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="24.0" right="24.0" top="16.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label style="-fx-text-fill: #2eb872;" text="Tonguely">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="perfilButton" mnemonicParsing="false" onAction="#irAPerfil" style="-fx-background-radius: 20; -fx-min-width: 40; -fx-min-height: 40; -fx-max-width: 40; -fx-max-height: 40; -fx-font-size: 18;" text="👤">
                     <tooltip>
                        <Tooltip text="Mi perfil" />
                     </tooltip>
                  </Button>
                  <Button fx:id="cerrarSesionButton" mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar sesión" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label fx:id="bienvenidaLabel" text="BIENVENIDO usuario!">
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="🔥">
                     <font>
                        <Font size="30.0" />
                     </font>
                  </Label>
                  <Label fx:id="rachaLabel" text="0">
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
         <tabs>
            <Tab text="Mis cursos">
               <content>
                  <fx:include fx:id="misCursos" source="seleccionCurso.fxml" />
               </content>
            </Tab>
            <Tab text="Explorar Cursos">
               <content>
                  <fx:include fx:id="Cursos" source="todosLosCursos.fxml" />
               </content>
            </Tab>
         </tabs>
         <BorderPane.margin>
            <Insets bottom="16.0" left="24.0" right="24.0" />
         </BorderPane.margin>
      </TabPane>
   </center>
</BorderPane>