<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tonguely.Controller.GestionUsuariosController">
   <center>
      <VBox spacing="6.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="5.0" top="10.0" />
         </padding>
         <children>
            <Label text="Usuarios">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <HBox spacing="8.0">
               <children>
                  <Label style="-fx-background-color: #C8E6C9; -fx-padding: 2 10 2 10; -fx-background-radius: 6;" text="Alumno tuyo" />
                  <Label style="-fx-background-color: #FFCDD2; -fx-padding: 2 10 2 10; -fx-background-radius: 6;" text="No comparte curso contigo" />
               </children>
            </HBox>
            <TextField fx:id="buscarField" promptText="🔍 Buscar por nombre o correo" />
            <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colNombre" prefWidth="160.0" text="Nombre" />
                  <TableColumn fx:id="colEmail" prefWidth="200.0" text="Correo" />
                  <TableColumn fx:id="colRacha" prefWidth="70.0" text="🔥 Racha" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <right>
      <VBox prefWidth="300.0" spacing="6.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="5.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="Datos del usuario">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Label text="Nombre" />
            <Label fx:id="nombreLabel" text="-" />
            <Label text="Correo electrónico" />
            <Label fx:id="emailLabel" text="-" />
            <Label text="Racha (correctas)" />
            <Label fx:id="rachaLabel" text="-" />
            <Label text="Cursos en común (puedes quitarlo de ellos)" />
            <ListView fx:id="listaComunes" prefHeight="100.0" VBox.vgrow="ALWAYS" />
            <Button fx:id="eliminarButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#eliminarUsuario" text="Quitar del curso seleccionado" />
            <Label text="Inscribir en uno de tus cursos" />
            <ComboBox fx:id="comboDisponibles" maxWidth="Infinity" promptText="Elige un curso" />
            <Button fx:id="nuevoButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#nuevoUsuario" text="Inscribir en el curso" />
         </children>
      </VBox>
   </right>
</BorderPane>