<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<BorderPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tonguely.Controller.ViewLogController">
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="6.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Label text="Registro de operaciones">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <ComboBox fx:id="cbTipo" prefWidth="150.0" promptText="Todos los tipos" />
                  <CheckBox fx:id="chBSoloError" mnemonicParsing="false" text="Solo errores" />
                  <TextField fx:id="tFBuscar" promptText="Buscar por usuario o detalle" />
                  <Button fx:id="bActualizar" mnemonicParsing="false" onAction="#actualizar" text="Actualizar" textAlignment="CENTER" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
            <TableView fx:id="tVLog" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colFecha" prefWidth="75.0" text="Fecha" />
                <TableColumn fx:id="colUsuario" prefWidth="75.0" text="Usuario" />
                  <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
                  <TableColumn fx:id="colColeccion" prefWidth="75.0" text="Colección" />
                  <TableColumn fx:id="colResultado" prefWidth="75.0" text="Resultado" />
                  <TableColumn fx:id="colDetalle" prefWidth="75.0" text="Detalle" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
