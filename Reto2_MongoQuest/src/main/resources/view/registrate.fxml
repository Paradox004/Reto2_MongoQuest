<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<ScrollPane fx:id="root" fitToHeight="true" fitToWidth="true" minHeight="460.0" minWidth="360.0" prefHeight="600.0" prefWidth="720.0" style="-fx-background-color: #f2faf6; -fx-background: #f2faf6;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tonguely.Controller.RegistrateController">
   <content>
      <StackPane style="-fx-background-color: #f2faf6;">
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
         </padding>
         <children>
            <VBox alignment="TOP_CENTER" fillWidth="true" maxHeight="-Infinity" maxWidth="460.0" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #057d4d; -fx-border-width: 1;" StackPane.alignment="CENTER">
               <padding>
                  <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#057d4d" height="25.0" stroke="BLACK" strokeType="INSIDE" width="27.0" />
                        <Label text="Tonguely">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>

                  <Label text="Ups... ¡Registrate antes!">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
                  <Label maxWidth="1.7976931348623157E308" text="¡Regístrate ahora para poder empezar con tus lecciones ahora mismo!" textAlignment="CENTER" textFill="#4e4e4e" wrapText="true">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>

                  <Button fx:id="registrarButton" maxWidth="1.7976931348623157E308" minHeight="40.0" mnemonicParsing="false" onAction="#registrarUsuario" prefHeight="75.0" prefWidth="402.0" text="Regístrate gratis">
                     <VBox.margin>
                        <Insets top="14.0" />
                     </VBox.margin>
                     <font>
                        <Font size="32.0" />
                     </font>
                  </Button>

                  <HBox spacing="12.0">
                     <children>
                        <Button fx:id="iniciarSesionButton" maxWidth="1.7976931348623157E308" minHeight="50.0" mnemonicParsing="false" onAction="#iniciarSesion" text="¿Ya tienes una cuenta? Iniciar sesión →" textAlignment="CENTER" wrapText="true" HBox.hgrow="ALWAYS">
                           <font>
                              <Font name="System Italic" size="11.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </content>
</ScrollPane>
